# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Scraped data — regenerable from a crawl, never commit
data/raw/
data/pages/
data/out/

# Runtime artefacts written by the platform itself, not sources:
# `chroma_us103_probe/` is the CR-01 persistence benchmark's collection (US-103);
# deleting it costs a re-run, not a rebuild.
data/chroma_us103_probe/
data/chroma_anita/

# Keep the directory skeletons
!data/raw/.gitkeep
!data/pages/.gitkeep
!data/out/.gitkeep

# Local secrets / overrides
.env
config/site.local.yaml
