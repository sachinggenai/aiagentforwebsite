# ANITA MEDICAL SYSTEMS platform — environment template.
#
# KEY NAMES ONLY. No value in this file is real, and no value from the source
# repository (`D:\project\universityDemo\.env*`) was copied here — those files
# are marked `forbidden` in docs/sdlc/07-brownfield-reconciliation.md (REC-21).
#
# Copy to `.env` and fill in. `.env` is gitignored.
# Every key whose name matches TOKEN|SECRET|PASSWORD|PASSWD|KEY|CREDENTIAL|SID|AUTH
# is masked in all output; only presence is ever reported.

# ---- Isolation (BRD-18) ----------------------------------------------------
# Asserted at boot. A collision with the sibling deployment refuses startup.
ANITA_DB_NAME=anita_ams
ANITA_DB_SCHEMA=anita
ANITA_CHROMA_PATH=./data/chroma_anita
ANITA_CHROMA_COLLECTION=anita_ams__v1
ANITA_API_PORT=8100
ANITA_CHAT_PORT=8601
ANITA_ADMIN_PORT=8602
ANITA_LOG_DIR=./logs/anita

# ---- Database (PostgreSQL) -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=

# ---- Telephony (Twilio) ----------------------------------------------------
# Same Twilio account as the sibling product; a NEW number dedicated to ANITA
# (decision D3). The sibling's number must not appear here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ---- Public ingress --------------------------------------------------------
# Twilio must reach the webhooks over public HTTPS.
#
# HOSTNAME ONLY — no scheme, no trailing slash. It is read ONCE AT BOOT and
# signature validation is computed against `https://<TUNNEL_HOST>`, so a change
# needs a restart. A Cloudflare *quick* tunnel mints a new hostname every time
# it restarts, which means this must be re-set and the instance restarted
# whenever the tunnel does. See docs/twilio-voice-setup.md.
TUNNEL_HOST=

# Spoken in the busy message when all call slots are taken, so a refused caller
# has a number to dial back. Blank plays the message without one.
ANITA_CALLBACK_NUMBER=

# ---- Outbound demo calls ---------------------------------------------------
# The ONLY numbers this instance may dial, comma-separated, E.164. Blank means
# nothing is dialable — unset must not mean unrestricted.
#
# This is not the US-021 follow-up worker, which stays blocked on the DG-08
# review of calling real buyers. It is the allowlist for `scripts/demo_call.py`,
# a one-call demo instrument, and it is enforced twice: by the script before it
# dials, and by the product when Twilio asks for the outbound TwiML — so a call
# placed by anything else still cannot reach a number that is not listed here.
ANITA_DEMO_CALL_ALLOWLIST=

# ---- WebRTC transport (optional) -------------------------------------------
# Off by default. The browser-mic WebSocket at WS /voice/browser is the default
# transport and is unaffected either way; enabling this only adds a second one.
# When on, GET /webrtc serves the client for it.
ANITA_WEBRTC_ENABLED=false

# Comma-separated ICE servers. A STUN server is what makes a peer behind NAT
# reachable at all; add a TURN relay if the client's network needs one. A
# server sitting behind an HTTP tunnel has no inbound reachability of its own,
# so a relay is the fallback when direct connectivity fails.
ANITA_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# ---- Admin surface ---------------------------------------------------------
# Required. Boot refuses if unset.
ANITA_ADMIN_TOKEN=

# ---- Browser-mic voice (US-003) --------------------------------------------
# Signs the browser voice session token. Unset means a per-process secret:
# voice works, but a token minted before a restart stops verifying after it.
ANITA_SESSION_SECRET=

# ---- Extra messaging channel (US-002, DG-07) -------------------------------
# Switching a channel on is configuration, never code. The secret is the HMAC
# key its webhook signs with; the declaration and its capabilities live in
# config/anita.yaml under `channels.extra`.
ANITA_EXTRA_CHANNEL_ENABLED=false
ANITA_EXTRA_CHANNEL_ID=
ANITA_EXTRA_CHANNEL_PROVIDER=
ANITA_EXTRA_CHANNEL_ADDRESS=
ANITA_EXTRA_CHANNEL_SECRET=

# ---- Notifications (DG-12: sales-rep handoff defaults to email) ------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SALES_NOTIFY_EMAIL=

# ---- Models -----------------------------------------------------------------
ANITA_LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_KEEP_ALIVE=-1m
EMBED_MODEL=nomic-embed-text
MLX_BASE_URL=http://127.0.0.1:1234
MLX_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit

# ---- Outbound follow-up (DG-04 defaults) -----------------------------------
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_WINDOW_START=10:00
OUTBOUND_WINDOW_END=19:00
OUTBOUND_TIMEZONE=Asia/Kolkata

# ---- Sentiment --------------------------------------------------------------
SENTIMENT_W1=0.30
SENTIMENT_W2=0.30
SENTIMENT_W3=0.25
SENTIMENT_W4=0.15
SENTIMENT_EWMA_LAMBDA=0.35
NEGATIVE_ESCALATION_THRESHOLD=-0.20
